<view class="picker">
  <view class="picker-header">
    <text class="picker-label">{{label}}</text>
    <text wx:if="{{current}}" class="picker-meta">在 {{current}}</text>
  </view>
  <view wx:if="{{items.length}}" class="picker-chips">
    <button
      wx:for="{{items}}"
      wx:key="value"
      class="picker-chip {{item.selected ? 'selected' : ''}}"
      data-value="{{item.value}}"
      disabled="{{disabled}}"
      bindtap="onSelect"
      aria-label="选择地点：{{item.label}}"
    ><text class="chip-prefix">⌖</text><text>{{item.label}}</text></button>
  </view>
  <view wx:else class="picker-empty">{{emptyText}}</view>
</view>
