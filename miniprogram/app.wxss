/* 拾光同频全局设计规范：原创纸张手账视觉语言，无外部字体或第三方 UI 运行时依赖。 */
page {
  background: #f7f3e8;
  color: #302d28;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  line-height: 1.5;
}

button {
  box-sizing: border-box;
}

.notebook {
  min-height: 100vh;
  padding: 32rpx 28rpx 64rpx;
  box-sizing: border-box;
  background: #f7f3e8;
  color: #302d28;
}

.eyebrow {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #6c6c61;
}

.heading {
  margin: 12rpx 0 6rpx;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.25;
}

.marker {
  padding: 0 8rpx;
  background: #f2e4ad;
  border-radius: 6rpx;
}

.subtitle {
  margin-bottom: 28rpx;
  color: #6c6c61;
  font-size: 25rpx;
  line-height: 1.6;
}

.paper {
  background: #fffdf6;
  border: 2rpx solid #4d5146;
  border-radius: 22rpx 12rpx 20rpx 14rpx;
  box-shadow: 5rpx 6rpx 0 #d8decf;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 28rpx;
  min-height: 84rpx;
  background: #fffdf6;
  color: #302d28;
  border: 2rpx solid #4d5146;
  border-radius: 16rpx 10rpx 18rpx 12rpx;
  font-size: 28rpx;
  line-height: 1.4;
}

.button::after,
.link-button::after {
  border: 0;
}

.button.primary {
  background: #dce7cf;
  font-weight: 600;
}

.button.danger {
  background: #f7e3dc;
  color: #8c3b28;
}

.button[disabled] {
  color: #777970;
  background: #e9e9df;
}

.button:active {
  transform: translateY(2rpx);
}

.field-label {
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #3f423a;
}

.field-input {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  background: #fbf8ee;
  border: 2rpx solid #9aa08f;
  border-radius: 14rpx 8rpx 14rpx 8rpx;
  font-size: 28rpx;
  color: #302d28;
}

.muted {
  color: #6c6c61;
  font-size: 25rpx;
  line-height: 1.6;
}

.error {
  color: #a03e2c;
  font-size: 25rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.state {
  padding: 36rpx 28rpx;
  margin-bottom: 24rpx;
}

.link-button {
  display: inline-block;
  margin: 0;
  padding: 12rpx;
  background: transparent;
  color: #506346;
  font-size: 25rpx;
  text-decoration: underline;
}
