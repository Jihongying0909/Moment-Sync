# Copy this file to a local environment file and fill in local values.
# Never commit real passwords, tokens, AppSecret, or private keys.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=moment_sync
DB_USERNAME=moment_sync
DB_PASSWORD=change_me

JWT_SECRET=replace_with_a_long_random_local_secret
UPLOAD_DIR=./uploads
# Public backend origin reachable by the mini program (not the /api base URL).
UPLOAD_PUBLIC_BASE_URL=http://localhost:8080
CAMPUS_MOODS=开心,平静,期待,充实,疲惫,难过
CAMPUS_LOCATIONS=图书馆,运动场,活动中心,教学楼,食堂,宿舍
API_BASE_URL=http://localhost:8080/api

WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=do_not_commit_real_secret

# Moment Sync AI Agent (OpenAI-compatible endpoint; falls back to local rules if LLM_API_KEY is empty)
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=replace_with_your_local_api_key
LLM_MODEL=glm-4-flash

