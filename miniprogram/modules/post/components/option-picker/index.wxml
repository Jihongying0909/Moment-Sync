<view class="option-picker">
  <view class="field-label">{{label}}</view>
  <view wx:if="{{options.length}}" class="chips">
    <button
      wx:for="{{options}}"
      wx:key="value"
      class="chip {{item.selected ? 'selected' : ''}}"
      data-value="{{item.value}}"
      disabled="{{disabled}}"
      bindtap="onTap"
      aria-label="选择{{label}}：{{item.label}}"
    >{{item.label}}</button>
  </view>
  <view wx:else class="muted">{{emptyText}}</view>
</view>
